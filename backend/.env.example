APP_ENV=development
APP_NAME=domain-knowledge-bot

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Cost routing: simple grounded lookups -> fast model (2x cheaper),
# complex synthesis -> GROQ_MODEL. Set ENABLE_MODEL_ROUTING=false to
# always use GROQ_MODEL.
ENABLE_MODEL_ROUTING=true
GROQ_FAST_MODEL=openai/gpt-oss-20b

EMBEDDING_MODEL=all-MiniLM-L6-v2

CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Table structure extraction (unstructured "hi_res" path). Off by default:
# downloads a layout-detection model from huggingface.co on first use unless
# pre-cached (see backend/scripts/warm_models.py, run at Docker build time).
ENABLE_TABLE_EXTRACTION=false

# Retrieval: candidate pool per leg (before RRF fusion) and chunks kept
# after reranking, sent to the LLM.
TOP_K=40
RERANK_TOP_K=8
MAX_CONTEXT_TOKENS=5000

# Reranking: downloads a model from huggingface.co on first use unless
# pre-cached (see backend/scripts/warm_models.py). Falls back to plain
# RRF-score reranking when false.
ENABLE_CROSS_ENCODER_RERANKER=true

# Threshold on the cross-encoder's calibrated 0-1 relevance score (0.5 =
# model finds the top chunk more likely relevant than not) below which the
# system refuses rather than risks answering ungrounded. Not empirically
# tuned yet — validate against real queries once deployed.
MIN_GROUNDING_SCORE=0.5

ENABLE_RESPONSE_CACHE=true
ENABLE_RETRIEVAL_CACHE=true
ENABLE_EMBEDDING_CACHE=true
CACHE_TTL=600

MAX_FILE_SIZE_MB=25

CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

GROQ_INPUT_COST_PER_MILLION=0.15
GROQ_OUTPUT_COST_PER_MILLION=0.60
GROQ_FAST_INPUT_COST_PER_MILLION=0.075
GROQ_FAST_OUTPUT_COST_PER_MILLION=0.30
